package-as: JiberishIcons
manual-changelog:
    filename: changelog.md
    markup-type: markdown
move-folders:
    JiberishIcons/JiberishIcons: JiberishIcons
enable-toc-creation: no
ignore:
    - .github
    - .gitattributes
    - .gitignore
    - .hgignore
    - .DS_Store
    - .release
    - dist
    - RELEASE-CANDIDATE.md
    - artwork
    - tools
    - images
    - tests
    - DEVELOPMENT.md
    - docs
    - README.md
    - ElvUI_JiberishIcons
